{
  "name": "dsh-talk-map",
  "version": "0.1.66",
  "description": "Visual conversation map for DeepSeek Harness: an infinite whiteboard where every session is a card — drag to arrange, double-click to start a chat in place, draw an edge to fork a new session with injected context. Built for ADHD-friendly spatial memory. · DSH 可视化对话地图：会话即卡片，双击即聊，连线分叉带上下文的新对话。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Da0Mine/dsh-talk-map.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "talk-map",
    "conversation-map",
    "whiteboard",
    "session-manager"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs --publish",
    "build:client": "node scripts/build-client.mjs",
    "harness": "node test/serve.mjs 8791",
    "probe": "node test/probe.mjs",
    "test:layout": "node test/grid.test.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:host": "node scripts/build-host.mjs",
    "test:trash:real": "node test/real-host.mjs",
    "test:trash:api": "node test/trash-api.test.mjs",
    "test:lifecycle": "node test/session-lifecycle.test.mjs",
    "test:trash": "node test/session-trash.test.mjs",
    "test:trash:ui": "node test/trash-ui.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client/client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@xyflow/react": "^12.8.0",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "homepage": "https://github.com/Da0Mine/dsh-talk-map#readme",
  "bugs": {
    "url": "https://github.com/Da0Mine/dsh-talk-map/issues"
  }
}
